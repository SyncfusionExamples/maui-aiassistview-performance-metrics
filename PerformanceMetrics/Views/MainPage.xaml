<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiAiAssistViewPerformanceMetrics.ViewModels"
             x:Class="MauiAiAssistViewPerformanceMetrics.Views.MainPage"
             x:DataType="vm:ChatViewModel">
    <VerticalStackLayout
        Padding="20"
        Spacing="20"
        VerticalOptions="Center">
        <Label
            Text="AI AssistView Benchmark Sample"
            FontSize="24"
            HorizontalOptions="Center" />
        <Button
            Text="Load 100 Items"
            Command="{Binding LoadItemsCommand}" />
    </VerticalStackLayout>
</ContentPage>
