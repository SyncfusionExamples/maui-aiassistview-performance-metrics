<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:MauiAIAssistViewPerformanceMetrics.Behaviors"
             xmlns:vm="clr-namespace:MauiAIAssistViewPerformanceMetrics.ViewModels"
             xmlns:views="clr-namespace:MauiAIAssistViewPerformanceMetrics.Views"
             x:Class="MauiAIAssistViewPerformanceMetrics.Views.MainPage"
             x:DataType="vm:AssistViewModel">
    <VerticalStackLayout
        Padding="20"
        Spacing="20"
        VerticalOptions="Center">
        <Label
            Text="MAUI AI AssistView Benchmark Sample"
            FontSize="24"
            HorizontalOptions="Center" />
        <Button
            Text="Load 100 Items">
            <Button.Behaviors>
                <behaviors:NavigateToPageBehavior
                    Command="{Binding LoadItemsCommand}"
                    DestinationPageType="{x:Type views:AssistViewPage}" />
            </Button.Behaviors>
        </Button>
    </VerticalStackLayout>
</ContentPage>
